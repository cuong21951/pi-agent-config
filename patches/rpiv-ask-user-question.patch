+export function afkStep(afk: AfkConfig, start: number, now: number, lastInteraction: number, focused: boolean | undefined): AfkStep {
+	const since = focused === true ? now : start;
+	const idle = now - Math.max(lastInteraction, since);
+	const remainingSeconds =
+		idle >= afk.timeoutMs - afk.countdownMs ? Math.max(0, Math.ceil((afk.timeoutMs - idle) / 1000)) : Math.ceil(afk.timeoutMs / 1000);
+	return { start: since, remainingSeconds, fire: idle >= afk.timeoutMs };
+}

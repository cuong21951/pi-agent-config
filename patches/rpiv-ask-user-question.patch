+export function resolveEditorDisplayName(command: string): string | undefined {
+	const trimmed = command.trim();
+	if (!trimmed) return undefined;
+	const known = EDITOR_DISPLAY_NAMES[trimmed.toLowerCase()];
+	if (known) return known;
+	const base = trimmed.split(" ")[0];
+	const name = base?.split(/[\\/]/).pop();
+	if (!name) return undefined;
+	return EDITOR_DISPLAY_NAMES[name.toLowerCase()] ?? name;
+}

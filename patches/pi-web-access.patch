+
+// Claude Code 2.1.280 look for fetch (measured 2026-09-23): "● Fetch(url)" with a grey dot blinking while
+// it runs and a blue one once done, then "  ⎿ \u00a0Received 559 bytes (200 OK)" — the elbow's own NBSP
+// row (‘Le’ in the bundle) is used for both the running and the finished line. The finished set is
+// claude-tools' (shared through globalThis).
+const CLAUDE_ELBOW = "  ⎿ \u00a0";
+const claudeRows = ((globalThis as any).__claudeRows ??= { finished: new Set<string>(), failed: new Set<string>() }) as { finished: Set<string> };
+
+export function claudeDot(id: string, theme: { fg: (role: any, text: string) => string }, now = Date.now()): string {
+	if (claudeRows.finished.has(id)) return theme.fg("borderAccent", "● ");
+	return Math.floor(now / 500) % 2 === 0 ? theme.fg("muted", "● ") : "  ";
+}
+
+function claudeRow(render: (width: number) => string[]) {
+	return { render, invalidate() {} };
+}
+
+export function formatBytes(bytes: number): string {
+	const kb = bytes / 1024;
+	if (kb < 1) return `${bytes} bytes`;
+	const trim = (s: string) => s.replace(/\.0$/, "");
+	if (kb < 1024) return `${trim(kb.toFixed(1))}KB`;
+	const mb = kb / 1024;
+	if (mb < 1024) return `${trim(mb.toFixed(1))}MB`;
+	return `${trim((mb / 1024).toFixed(1))}GB`;
+}
+
+export function searchSummary(count: number, durationMs: number | undefined): string {
+	const searches = `${count} ${count === 1 ? "search" : "searches"}`;
+	if (durationMs === undefined) return `Did ${searches}`;
+	const took = durationMs >= 1000 ? `${Math.round(durationMs / 1000)}s` : `${Math.round(durationMs)}ms`;
+	return `Did ${searches} in ${took}`;
+}

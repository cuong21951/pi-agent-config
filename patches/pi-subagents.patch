+export type FleetRow = {
+  selected: boolean;
+  viewed: boolean;
+  bulletRole?: string;
+  name: string;
+  named: boolean;
+  description: string;
+  status: string;
+};
+
+export function fleetRowLine(row: FleetRow, labelWidth: number, statusWidth: number, width: number, theme: Theme): string {
+  const plain = !row.selected && !row.viewed;
+  const tone = (text: string, dim: boolean) => (row.viewed ? theme.bold(text) : dim ? theme.fg("muted", text) : text);
+  const bullet = `${row.viewed ? "●" : "◯"} `;
+  const name = truncateToWidth(row.name, labelWidth, "…");
+  const descriptionBox = Math.max(0, width - RIGHT_PADDING - BULLET_COLUMNS - labelWidth - 1 - statusWidth);
+  const description = truncateToWidth(row.description, Math.max(0, descriptionBox - 2), "…");
+  return [
+    tone(row.selected ? "❯ " : "  ", plain),
+    row.bulletRole ? tone(theme.fg(row.bulletRole, bullet), false) : tone(bullet, plain),
+    tone(name, plain && !row.named),
+    " ".repeat(labelWidth - visibleWidth(name) + Math.min(2, descriptionBox)),
+    tone(description, plain),
+    " ".repeat(Math.max(0, descriptionBox - 2 - visibleWidth(description)) + 1 + statusWidth - visibleWidth(row.status)),
+    tone(row.status, plain),
+  ].join("");
+}
+
+export function fleetMainLine(selected: boolean, viewed: boolean, moreAbove: number, width: number, theme: Theme): string {
+  const text = `${selected ? "❯ " : "  "}${viewed ? "●" : "◯"} main`;
+  const left = viewed ? theme.bold(text) : selected ? text : theme.fg("muted", text);
+  if (moreAbove === 0) return left;
+  const more = `↑ ${moreAbove} more`;
+  return left + " ".repeat(Math.max(1, width - RIGHT_PADDING - visibleWidth(text) - visibleWidth(more))) + theme.fg("muted", more);

+    row.bulletRole ? tone(theme.fg(row.bulletRole, bullet), false) : tone(bullet, plain),
+    tone(name, plain && !row.named),
+    " ".repeat(labelWidth - visibleWidth(name) + Math.min(2, descriptionBox)),
+    tone(description, plain),
+    row.inline ? "  " : " ".repeat(Math.max(0, descriptionBox - 2 - visibleWidth(description)) + 1 + statusWidth - visibleWidth(row.status)),

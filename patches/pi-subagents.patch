+
+export function fleetWindow(focus: number, count: number, size = MAX_AGENT_ROWS): { start: number; end: number } {
+  const start = Math.min(Math.max(0, focus - size + 1), Math.max(0, count - size));
+  return { start, end: Math.min(start + size, count) };

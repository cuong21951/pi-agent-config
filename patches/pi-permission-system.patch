+function findToolSurfaceSection(lines: readonly string[], header: string): LineSection | null {
+  for (let section = findSection(lines, header); section; section = findSection(lines, header, section.start + 1)) {
+    if (header !== GUIDELINES_SECTION_HEADER || isPiGuidelines(lines, section)) return section;
+  }
+  return null;
+}
+
+function isPiGuidelines(lines: readonly string[], section: LineSection): boolean {
+  const body = lines.slice(section.start + 1, section.end).map((line) => line.trim());
+  return UNIVERSAL_GUIDELINES.every((guideline) => body.includes(`- ${guideline}`));
+}

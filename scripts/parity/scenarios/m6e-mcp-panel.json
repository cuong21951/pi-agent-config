{
 "prompt": "",
 "bypass": true,
 "pi_args": "--mcp-config {parity}/mcp-pi-panel.json",
 "claude_args": "--mcp-config {parity}/mcp-claude.json",
 "steps": [
  {"keys": "/mcp"},
  {"until": "(?m)^  /mcp", "timeout": 10},
  {"keys": "\r"},
  {"until": "Esc to cancel", "timeout": 10},
  {"snap": "list"},
  {"keys": "\r"},
  {"until": "Config location", "timeout": 10},
  {"snap": "actions"},
  {"keys": "\r"},
  {"until": "Tools for parity", "timeout": 10},
  {"snap": "tools"},
  {"keys": "\r"},
  {"until": "Full name", "timeout": 10},
  {"snap": "detail"},
  {"keys": "\u001b"},
  {"until": "Tools for parity", "timeout": 10},
  {"keys": "\u001b"},
  {"until": "Config location", "timeout": 10},
  {"keys": "\u001b"},
  {"until": "Manage MCP servers", "timeout": 10},
  {"snap": "back"},
  {"keys": "\u001b"},
  {"until": "(?m)^❯", "timeout": 10},
  {"snap": "closed"}
 ],
 "end": "(?m)^❯"
}

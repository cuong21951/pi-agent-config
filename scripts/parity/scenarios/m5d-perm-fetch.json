{
 "bypass": false,
 "prompt": "Fetch https://httpbin.org/html with your fetch_content tool. Then reply with exactly: done. No other text.",
 "steps": [
  {
   "until": "(?m)^(?!❯ ).*(proceed|Allow|allow|Yes)",
   "timeout": 90
  },
  {
   "sleep": 3
  },
  {
   "snap": "asking"
  },
  {
   "keys": "\r"
  },
  {
   "until": "✻ \\S+ for [^\n]*· done",
   "timeout": 90
  },
  {
   "sleep": 1
  }
 ]
}
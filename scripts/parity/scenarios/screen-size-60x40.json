{
 "prompt": "Do not use any tool. Write exactly fourteen paragraphs about lighthouses, separated by blank lines. Each paragraph has four long sentences.",
 "rows": 40,
 "cols": 60,
 "steps": [
  {
   "until": "(?m)^● \\S",
   "timeout": 120
  },
  {
   "resize": [
    40,
    72
   ]
  },
  {
   "until": "✻ \\S+ for [^\n]*· done",
   "timeout": 240
  },
  {
   "sleep": 2
  },
  {
   "snap": "done"
  },
  {
   "keys": "\u001b[5~"
  },
  {
   "sleep": 1
  },
  {
   "keys": "\u001b[5~"
  },
  {
   "sleep": 1
  },
  {
   "snap": "scrolled"
  },
  {
   "resize": [
    30,
    60
   ]
  },
  {
   "sleep": 2
  },
  {
   "snap": "resized-scrolled"
  },
  {
   "keys": "\u001b[1;5F"
  },
  {
   "sleep": 1
  },
  {
   "snap": "bottom"
  }
 ],
 "end": "."
}
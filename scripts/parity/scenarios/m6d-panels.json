{
 "prompt": "",
 "bypass": true,
 "pi_args": "--mcp-config {parity}/mcp-none.json",
 "steps": [
  {"keys": "/status"},
  {"until": "(?m)^  /status", "timeout": 10},
  {"keys": "\r"},
  {"until": "Esc to cancel", "timeout": 10},
  {"snap": "status"},
  {"keys": "\u001b"},
  {"until": "(?m)^❯", "timeout": 10},
  {"keys": "/usage"},
  {"until": "(?m)^  /usage", "timeout": 10},
  {"keys": "\r"},
  {"until": "Esc to cancel", "timeout": 10},
  {"snap": "usage"},
  {"keys": "\u001b"},
  {"until": "(?m)^❯", "timeout": 10},
  {"keys": "/context"},
  {"until": "(?m)^  /context", "timeout": 10},
  {"keys": "\r"},
  {"until": "/context all to expand", "timeout": 10},
  {"snap": "context"}
 ],
 "end": "/context all to expand"
}
